{
  "name": "darksafari",
  "version": "0.2.3",
  "private": true,
  "description": "Free, open-source dark mode for Safari (macOS + iOS) as a userscript, powered by the Dark Reader engine.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "update-fixes": "curl -fsSL https://raw.githubusercontent.com/darkreader/darkreader/main/src/config/dynamic-theme-fixes.config -o vendor/dynamic-theme-fixes.config"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "darkreader": "^4.9.133",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
